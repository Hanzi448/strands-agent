# Read at build time by `src/dashboard/lib/auth.ts` and
# `src/dashboard/lib/dashboardApi.ts`. Values come from the deployed
# `ApiStack`'s `CfnOutput`s (`backend/infra/api_stack.py`):
#   VITE_DASHBOARD_API_URL      <- DashboardApiUrl
#   VITE_STAFF_USER_POOL_ID     <- StaffUserPoolId
#   VITE_STAFF_USER_POOL_CLIENT_ID <- StaffUserPoolClientId
VITE_DASHBOARD_API_URL=
VITE_STAFF_USER_POOL_ID=
VITE_STAFF_USER_POOL_CLIENT_ID=
# Patient voice UI (`src/voice/`). Values come from the deployed
# stacks' CfnOutputs:
#   VITE_AGENT_RUNTIME_ARN              <- AgentStack AgentRuntimeArn
#   VITE_PATIENT_GUEST_IDENTITY_POOL_ID <- ApiStack PatientGuestIdentityPoolId
#   VITE_PATIENT_GUEST_ROLE_ARN         <- ApiStack PatientGuestRoleArn
#   VITE_REGION                         <- deployment region (us-east-1)
VITE_AGENT_RUNTIME_ARN=
VITE_PATIENT_GUEST_IDENTITY_POOL_ID=
VITE_PATIENT_GUEST_ROLE_ARN=
VITE_REGION=
# Optional local-dev bypass: skip presigning and connect directly to a
# locally running agentcore_app (e.g. VITE_AGENT_RUNTIME_URL=/ws,
# served behind a Vite dev-server proxy you configure yourself).
VITE_LOCAL_DEV=
VITE_AGENT_RUNTIME_URL=
